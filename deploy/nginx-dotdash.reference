server {
    listen 80;
    server_name app.dotdashdevice.com;
    # Force redirect to secure HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name app.dotdashdevice.com;

    # Point directly to the SSL certs we generated earlier
    ssl_certificate /etc/letsencrypt/live/app.dotdashdevice.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.dotdashdevice.com/privkey.pem;

    root /var/www/dotdash/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # The app is ONE html file that changes on every deploy, and an installed
    # iOS PWA will happily serve a stale copy for days -- which looks exactly
    # like a fix that did not work. no-cache does not mean do not cache: with
    # the ETag above it means revalidate first, so an unchanged file still costs
    # only a 304.
    location ~* \.(html)$ {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # Same for the service worker and the manifest. A stale service worker is
    # worse than a stale page: it silently keeps handling pushes with old code.
    location ~* ^/(firebase-messaging-sw\.js|manifest\.json)$ {
        add_header Cache-Control "no-cache, must-revalidate";
    }
}
