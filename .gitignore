# macOS
.DS_Store

# Node
node_modules/
npm-debug.log*

# Build output. `npm run build` emits ONE self-contained dist/index.html that
# serves both targets: scp it to the server for the web, and Capacitor points
# its webDir here for iOS. Generated, so it stays out of git -- the source is
# app/index.html + app/src/.
dist/

# Capacitor copies the web assets into the iOS project on `cap sync`.
ios/App/App/public/

# Capacitor regenerates this from the root capacitor.config.json on every sync.
ios/App/App/capacitor.config.json

# Xcode build output. ios/build/ is the -derivedDataPath used by the build
# script; DerivedData/ is where Xcode.app puts it by default.
ios/App/Pods/
ios/App/build/
ios/build/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
DerivedData/
*.xcuserstate

# Credentials -- must never be committed.
#
# The Firebase service account JSON is the worst one to leak: it is a private
# key granting ADMIN access to the whole project -- every user's Firestore data,
# and the ability to mint auth tokens as anyone. It belongs on the droplet at
# 0600 and nowhere else, never in this repo. The patterns below cover the names
# the Firebase console hands out.
*firebase-adminsdk*.json
*service-account*.json
*serviceaccount*.json
dotdash-*-firebase*.json

*.p8
*.p12
*.mobileprovision
GoogleService-Info.plist
